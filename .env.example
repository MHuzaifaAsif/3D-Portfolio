# .env.example
# Copy this file to .env and fill in your credentials

# =========================================================
# Resend Email Service Configuration (https://resend.com)
# =========================================================
# 1. Sign up at https://resend.com
# 2. Add and verify your domain (or use onboarding domain for testing)
# 3. Generate an API key from the dashboard
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Muhammad Huzaifa <mhuzaifa.asif412@gmail.com>"
CONTACT_TO_EMAIL="mhuzaifa.asif412@gmail.com"
CONTACT_SITE_URL="https://your-portfolio.vercel.app"
RESEND_TEMPLATE_CONTACT_USER="contact-thank-you"
RESEND_TEMPLATE_CONTACT_ADMIN="contact-admin"

# =========================================================
# Google reCAPTCHA v3 Configuration (https://www.google.com/recaptcha/admin)
# =========================================================
# 1. Register your site at https://www.google.com/recaptcha/admin/create
# 2. Select reCAPTCHA v3
# 3. Add your domains (e.g. localhost, your-portfolio.vercel.app)
VITE_RECAPTCHA_SITE_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_MIN_SCORE="0.5"
